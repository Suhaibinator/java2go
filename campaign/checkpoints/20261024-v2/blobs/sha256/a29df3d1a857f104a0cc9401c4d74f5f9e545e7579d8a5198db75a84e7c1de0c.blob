package stdjava

import (
	"crypto/sha256"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"io/fs"
	"os"
	"path/filepath"
	"reflect"
	"strconv"
	"strings"
	"testing"
)

// Inputs/results below are an exact field projection of the immutable measured
// RAF author oracle f248f1fb856fb469d738378a0e4615bc36315bb6ffb9c13a3af9384af5a9793a.
// The JDK matrix's observer APIs are not additional compiler API admissions.
// Native tests use existing byte-array writes/readers and inspect descriptor
// state directly; they do not claim compilation of getFD, write(int), or the
// matrix's arbitrary source File-return helpers. Original DigestIO stays whole.
type raf209MeasuredRow struct {
	Label        string `json:"label"`
	Overload     string `json:"overload"`
	Path         string `json:"pathUTF16"`
	Mode         string `json:"modeUTF16"`
	Failure      string `json:"failure"`
	State        string `json:"state"`
	ClosedRead   string `json:"closedRead"`
	CloseFailure string `json:"closeFailure"`
}

func raf209Units(t *testing.T, text string) *JavaString {
	t.Helper()
	if text == "null" {
		return nil
	}
	if len(text)%4 != 0 {
		t.Fatal("invalid measured UTF16")
	}
	units := make([]uint16, len(text)/4)
	for i := range units {
		v, err := strconv.ParseUint(text[i*4:i*4+4], 16, 16)
		if err != nil {
			t.Fatal(err)
		}
		units[i] = uint16(v)
	}
	return NewJavaStringUTF16(units)
}
func raf209Panic(action func()) (failure any) {
	defer func() { failure = recover() }()
	action()
	return nil
}
func raf209Failure(t *testing.T, e *Execution, failure any) string {
	t.Helper()
	if failure == nil {
		return "none"
	}
	throwable, ok := failure.(Throwable)
	if !ok {
		t.Fatalf("non-Java panic %T:%v", failure, failure)
	}
	message := JavaThrowableMessageExecution(e, failure)
	text := "null"
	if message != nil {
		var b strings.Builder
		for _, unit := range message.units {
			fmt.Fprintf(&b, "%04x", unit)
		}
		text = b.String()
	}
	return fmt.Sprintf("%s/messageUTF16=%s/causeNull=%t", BuiltinThrowableTypeID(throwable.ThrowableTypeName()), text, GetCause(failure) == nil)
}
func raf209FileSnapshot(t *testing.T) map[string]string {
	t.Helper()
	out := map[string]string{}
	err := filepath.WalkDir("data", func(path string, entry fs.DirEntry, err error) error {
		if err != nil {
			return err
		}
		if entry.IsDir() {
			out[filepath.ToSlash(path)+"/"] = "directory"
			return nil
		}
		data, err := os.ReadFile(path)
		if err != nil {
			return err
		}
		out[filepath.ToSlash(path)] = fmt.Sprintf("%x", sha256.Sum256(data))
		return nil
	})
	if err != nil {
		t.Fatal(err)
	}
	return out
}

func TestRAFFile209MeasuredNativeContracts(t *testing.T) {
	var rows []raf209MeasuredRow
	if err := json.Unmarshal([]byte(raf209MeasuredRows), &rows); err != nil {
		t.Fatal(err)
	}
	if len(rows) != 56 {
		t.Fatal("measured row coverage drift")
	}
	var finalFiles map[string]map[string]string
	if err := json.Unmarshal([]byte(raf209MeasuredFinalFiles), &finalFiles); err != nil {
		t.Fatal(err)
	}
	for _, seed := range []int{17, 41, 97} {
		t.Run(strconv.Itoa(seed), func(t *testing.T) {
			t.Chdir(t.TempDir())
			if err := os.MkdirAll("data/directory", 0700); err != nil {
				t.Fatal(err)
			}
			e := NewExecution()
			for index, row := range rows {
				t.Run(row.Label, func(t *testing.T) {
					if index == 0 || index == 28 {
						if err := os.WriteFile("data/present.bin", []byte{1, 2, 3, 4, 5}, 0600); err != nil {
							t.Fatal(err)
						}
					}
					path, mode := raf209Units(t, row.Path), raf209Units(t, row.Mode)
					before := raf209FileSnapshot(t)
					var file *RandomAccessFile
					failure := raf209Panic(func() {
						if row.Overload == "File" {
							var native *JavaFile
							if path != nil {
								native = NewJavaFileReference(path)
							}
							file = NewRandomAccessFileFileExecution(e, native, mode)
						} else {
							file = NewRandomAccessFileStringExecution(e, path, mode)
						}
					})
					if got := raf209Failure(t, e, failure); got != row.Failure {
						t.Fatalf("constructor=%s want measured %s", got, row.Failure)
					}
					if failure != nil {
						if file != nil || !reflect.DeepEqual(before, raf209FileSnapshot(t)) {
							t.Fatal("failed constructor changed filesystem/published resource")
						}
						return
					}
					if file == nil || file.state == nil || file.GetChannel() == nil || file.GetChannel().state != file.state {
						t.Fatal("native RAF/channel must publish one shared state")
					}
					descriptor := file.state.file
					if _, err := descriptor.Stat(); err != nil {
						t.Fatal("successful descriptor invalid", err)
					}
					defer file.Close()
					state := fmt.Sprintf("initialLength=%d,initialPointer=%d", file.Length(), file.GetFilePointer())
					switch {
					case strings.HasSuffix(row.Label, "read-only"):
						failure := raf209Panic(func() { RandomAccessFileWriteBytesExecution(e, file, rafWriteArray(int8(seed))) })
						state += fmt.Sprintf(",readOnlyWrite=%s,afterWritePointer=%d,first=%d", raf209Failure(t, e, failure), file.GetFilePointer(), file.ReadByteValue())
					case strings.HasSuffix(row.Label, "existing-rw"):
						file.SeekPosition(2)
						RandomAccessFileWriteBytesExecution(e, file, rafWriteArray(int8(seed+40)))
						written := file.GetFilePointer()
						RandomAccessFileSetLengthExecution(e, file, 2)
						shortened := file.GetFilePointer()
						RandomAccessFileSetLengthExecution(e, file, 6)
						file.SeekPosition(0)
						data := make([]byte, 6)
						if _, err := io.ReadFull(file, data); err != nil {
							t.Fatal(err)
						}
						state += fmt.Sprintf(",writePointer=%d,truncatedPointer=%d,finalLength=%d,finalPointer=%d,bytes=%x", written, shortened, file.Length(), file.GetFilePointer(), data)
					default:
						RandomAccessFileWriteBytesExecution(e, file, rafWriteArray(int8(seed), 0, -1))
						state += fmt.Sprintf(",finalLength=%d,finalPointer=%d", file.Length(), file.GetFilePointer())
					}
					if state != row.State {
						t.Fatalf("state=%s want measured %s", state, row.State)
					}
					channel := file.GetChannel()
					if channel != file.GetChannel() || rafWriteChannelPosition(t, file.GetChannel()) != file.GetFilePointer() {
						t.Fatal("channel identity/cursor diverged")
					}
					closeFailure := raf209Panic(func() { file.Close() })
					if got := raf209Failure(t, e, closeFailure); got != row.CloseFailure {
						t.Fatalf("close=%s want measured %s", got, row.CloseFailure)
					}
					if _, err := descriptor.Stat(); !errors.Is(err, os.ErrClosed) {
						t.Fatal("closed descriptor did not report closed", err)
					}
					if file.state.file != descriptor || file.GetChannel().IsOpen() {
						t.Fatal("close identity/open state mismatch")
					}
					closed := raf209Panic(func() { file.ReadByteValue() })
					if got := raf209Failure(t, e, closed); got != row.ClosedRead {
						t.Fatalf("closed read=%s want measured %s", got, row.ClosedRead)
					}
					file.Close()
				})
				if strings.HasSuffix(row.Label, "failed-parent") {
					parent := "file-parent"
					if row.Overload == "String" {
						parent = "string-parent"
					}
					if err := os.Mkdir("data/"+parent, 0700); err != nil {
						t.Fatal("failed open must not have created parent", err)
					}
				}
			}
			actual := raf209FileSnapshot(t)
			for name, value := range actual {
				if value == "directory" {
					delete(actual, name)
				}
			}
			if !reflect.DeepEqual(actual, finalFiles[strconv.Itoa(seed)]) {
				t.Fatalf("final measured file snapshot differs: %v", actual)
			}
		})
	}
}

func TestRAFFile209ExecutionAndCleanup(t *testing.T) {
	path := JavaStringFromHostUTF8(filepath.Join(t.TempDir(), "file"))
	file := NewJavaFileReference(path)
	if failure := raf209Panic(func() { NewRandomAccessFileFileExecution(nil, file, JavaStringLiteralUTF16([]uint16{'r', 'w'})) }); failure == nil {
		t.Fatal("nil execution accepted")
	}
	e := NewExecution()
	raf := NewRandomAccessFileFileExecution(e, file, JavaStringLiteralUTF16([]uint16{'r', 'w'}))
	channel := raf.GetChannel()
	channel.Close()
	if channel.IsOpen() {
		t.Fatal("channel close did not close RAF state")
	}
	raf.Close()
	if _, err := os.Stat(file.path); err != nil {
		t.Fatal("explicit close unexpectedly removed file", err)
	}
}

